# Copy to .env and fill in. Never commit .env.
ES_URL=https://<deployment>.es.<region>.gcp.elastic.cloud
KB_URL=https://<deployment>.kb.<region>.gcp.elastic.cloud
ES_API_KEY=<base64 encoded API key with Elasticsearch + Kibana (rules, cases, workflows) privileges>
